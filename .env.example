# IDs públicos de mensuração (configure também em Vercel > Project Settings > Environment Variables)
# GA4 Measurement ID, por exemplo G-1234567890
VITE_GA4_ID=
# Google Ads Conversion ID, por exemplo AW-123456789
VITE_GOOGLE_ADS_ID=
# Rótulo da ação de conversão no Google Ads
VITE_GOOGLE_ADS_CONVERSION_LABEL=
# ID numérico do Meta Pixel
VITE_META_PIXEL_ID=
